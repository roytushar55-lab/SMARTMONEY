{
  "Jwt": {
    "Issuer": "SmartMoney.Api",
    "Audience": "SmartMoney.Client",
    "ExpirationMinutes": 60
  },

  "SupabaseStorage": {
    "Url": "",
    "Bucket": "profile-images",
    "CacheControlSeconds": 3600
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Email": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "FromAddress": "",
    "FromName": "SmartMoney",
    "EnableSsl": true
  },

  "Payouts": {
    "Provider": "Manual",
    "MinimumAmount": 250,
    "MaximumAmount": 50000,
    "FlatFee": 0,
    "PercentFee": 0,
    "FeeTaxPercent": 18,
    "UserFeeSharePercent": 50,
    "RequireAdminApproval": true,
    "MaxOpenWithdrawalsPerUser": 1,
    "MaxSubmissionAttempts": 5,
    "WorkerIntervalSeconds": 60,
    "WorkerBatchSize": 25,
    "ReconcileAfterMinutes": 15,
    "Fake": {
      "Behavior": "Success"
    }
  },

  "DataProtection": {
    "KeysPath": "",
    "CertificatePath": "",
    "UseDpapi": false,
    "AllowUnencryptedKeys": false
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "ForwardedHeaders": {
    "TrustAllProxies": false
  },

  "RateLimiting": {
    "AuthRequestsPerMinute": 20,
    "OtpRequestsPerTenMinutes": 10,
    "WithdrawalRequestsPerTenMinutes": 10
  },

  "AllowedHosts": "*"
}
