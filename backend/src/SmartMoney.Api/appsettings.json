{
  "Jwt": {
    "Issuer": "SmartMoney.Api",
    "Audience": "SmartMoney.Client",
    "ExpirationMinutes": 60
  },

  "SupabaseStorage": {
    "Url": "",
    "Bucket": "profile-images",
    "CacheControlSeconds": 3600
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Email": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "FromAddress": "",
    "FromName": "SmartMoney",
    "EnableSsl": true
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "ForwardedHeaders": {
    "TrustAllProxies": false
  },

  "RateLimiting": {
    "AuthRequestsPerMinute": 20,
    "OtpRequestsPerTenMinutes": 10
  },

  "AllowedHosts": "*"
}
